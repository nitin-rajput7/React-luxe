# Server Port
PORT=5000

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas URI or local MongoDB)
# Replace with your actual MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/luxe_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/luxe_db?retryWrites=true&w=majority
